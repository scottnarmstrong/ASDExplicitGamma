module

public import ASDExplicitGamma.Triadic.SensitivityDerivativeEstimate
public import Algsuperdiff.Frozen.Section24.PerturbCoeffOn
public import Algsuperdiff.Section5.Support.LipschitzRepresentative
public import Homogenization.Geometry.CubeMetric
public import Homogenization.Geometry.OverlapCube
public import Homogenization.Book.Ch02.MultiscaleEllipticity
public import Homogenization.Multiscale.NormalizedNorms
public import Mathlib.MeasureTheory.Function.LpSeminorm.LpNorm

/-! A bounded continuous coefficient representative for the Sobolev path. -/

@[expose] public section

namespace ASDExplicitGamma.Triadic

open Homogenization MeasureTheory ASDExplicitGamma.Response
open scoped ENNReal
open Set

noncomputable section

/-- The bounded-continuous coefficient path associated with a Sobolev
direction and a bounded-continuous base coefficient. -/
def sensitivityResponseCoefficientPath {Q : TriadicCube 2}
    (k : ResponseCoefficient (openCubeSet Q))
    (kH : ResponseCoefficient (openCubeSet Q)) (t : ℝ) :
    ResponseCoefficient (openCubeSet Q) := k + t • kH

/-- The planar sensitivity matrix is skew and hence is a legal Section 24
coefficient perturbation. -/
def sensitivitySkewMatrixDirection {Q : TriadicCube 2}
    (h : PlanarW2Infinity Q) :
    Algsuperdiff.Frozen.Section24.LInfSkewMatrixFieldOn (Book.Ch02.cubeDomain Q) := by
  refine ⟨sensitivityMatrixDirection h, ?_⟩
  filter_upwards with x
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [sensitivityMatrixDirection, responsePlanarJ, symmPart,
      smul_eq_mul]

/-- The planar matrix path generated by the continuous representative agrees
almost everywhere with the frozen Section 24 perturbation path. -/
theorem sensitivityBookCoeffOn_path_aeeq (Q : TriadicCube 2) (ν : ℝ)
    (hν : 0 < ν) (k : ResponseCoefficient (openCubeSet Q))
    (h : PlanarW2Infinity Q) (kH : ResponseCoefficient (openCubeSet Q))
    (hkH : responseCoefficientExtension kH =ᵐ[
      volume.restrict (openCubeSet Q)] h.value.toFun) (t : ℝ) :
    Book.Ch02.CoeffOn.AEEq
      (sensitivityBookCoeffOn Q ν hν (sensitivityResponseCoefficientPath k kH t))
      (Algsuperdiff.Frozen.Section24.perturbCoeffOn
        (Book.Ch02.cubeDomain Q) (sensitivityBookCoeffOn Q ν hν k)
        (sensitivitySkewMatrixDirection h) t) := by
  change (sensitivityBookCoeffOn Q ν hν
      (sensitivityResponseCoefficientPath k kH t)).toCoeffField =ᵐ[
        volume.restrict (openCubeSet Q)]
    (Algsuperdiff.Frozen.Section24.perturbCoeffOn
      (Book.Ch02.cubeDomain Q) (sensitivityBookCoeffOn Q ν hν k)
      (sensitivitySkewMatrixDirection h) t).toCoeffField
  filter_upwards [hkH,
    ae_restrict_mem (measurableSet_openCubeSet Q)] with x hrep_x hx
  have hpath : responseCoefficientExtension
        (sensitivityResponseCoefficientPath k kH t) x =
          responseCoefficientExtension k x + t * h.value.toFun x := by
    rw [sensitivityResponseCoefficientPath,
      responseCoefficientExtension_add_on k _ hx,
      responseCoefficientExtension_smul_on t _ hx, hrep_x]
  change responsePlanarCoefficient (ν / 1)
      (responseCoefficientExtension
        (sensitivityResponseCoefficientPath k kH t) x / 1) =
    responsePlanarCoefficient (ν / 1)
      (responseCoefficientExtension k x / 1) +
        t • (h.value.toFun x • responsePlanarJ)
  simp only [div_one]
  rw [hpath]
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [responsePlanarCoefficient, responsePlanarJ, Matrix.smul_apply,
      smul_eq_mul]; ring

/-- Restrict a bounded-continuous response coefficient to the closed cube of a
descendant. -/
noncomputable def sensitivityResponseCoefficientRestrict
    {Q R : TriadicCube 2} {j : ℕ}
    (k : ResponseCoefficient (openCubeSet Q))
    (hR : R ∈ descendantsAtDepth Q j) :
    ResponseCoefficient (openCubeSet R) := by
  let hsub := openCubeSet_subset_of_mem_descendantsAtDepth hR
  let incl : C(closure (openCubeSet R), closure (openCubeSet Q)) :=
    ⟨fun x => ⟨x.1, (closure_mono hsub) x.2⟩,
      continuous_subtype_val.subtype_mk fun x => (closure_mono hsub) x.2⟩
  exact k.compContinuous incl

/-- On the open descendant, the bounded-continuous extension of the restricted
coefficient agrees with the original extension. -/
theorem sensitivityResponseCoefficientRestrict_extension_ae
    {Q R : TriadicCube 2} {j : ℕ}
    (k : ResponseCoefficient (openCubeSet Q))
    (hR : R ∈ descendantsAtDepth Q j) :
    responseCoefficientExtension (sensitivityResponseCoefficientRestrict k hR) =ᵐ[
      volume.restrict (openCubeSet R)] responseCoefficientExtension k := by
  let hsub := openCubeSet_subset_of_mem_descendantsAtDepth hR
  let incl : C(closure (openCubeSet R), closure (openCubeSet Q)) :=
    ⟨fun x => ⟨x.1, (closure_mono hsub) x.2⟩,
      continuous_subtype_val.subtype_mk fun x => (closure_mono hsub) x.2⟩
  filter_upwards [ae_restrict_mem (measurableSet_openCubeSet R)] with x hx
  rw [responseCoefficientExtension_eq _ hx,
    responseCoefficientExtension_eq k (hsub hx)]
  change (k.compContinuous incl) ⟨x, subset_closure hx⟩ =
    k ⟨x, subset_closure (hsub hx)⟩
  rw [BoundedContinuousFunction.compContinuous_apply]
  congr 1

end

end ASDExplicitGamma.Triadic
