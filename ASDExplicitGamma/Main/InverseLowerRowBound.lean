/-! Pair the actual q3 row generated by distinct response variations with a
common source gradient. -/

@[expose] public section

open Homogenization MeasureTheory ASDExplicitGamma.Gaussian ASDExplicitGamma.Inverse
  ASDExplicitGamma.Response ASDExplicitGamma.Triadic ASDExplicitGamma.Variational
open scoped BigOperators ENNReal

namespace ASDExplicitGamma.Main

local instance mainInverseLowerRowBoundFiniteMeasure (n : ℤ) :
    IsFiniteMeasure (volumeMeasureOn (openCubeSet (originCube 2 n))) :=
  (isOpenBoundedConvexDomain_openCubeSet (originCube 2 n)).isFiniteMeasure_restrict_volume

/-- The actual uncentered q3 row, with a different zero-trace first potential
in every Gaussian direction, has the source row coefficient when paired with
any common H¹ source gradient. -/
theorem main_q3_distinct_h10_row_pairing_bound
    (n : ℤ) (b σ : ℝ) (L : {l : ℝ // 0 < l})
    (s : Finset whiteBasisIndex)
    (z : whiteBasisIndex → H10Function (openCubeSet (originCube 2 n)))
    (g : H1Function (openCubeSet (originCube 2 n))) :
    |volumeAverage (openCubeSet (originCube 2 n)) (fun x =>
        vecDot (pureFluxMainQ3DistinctRow n b σ L s z x) (g.grad x))| ≤
      |σ⁻¹| * mainQ3RowConstant (cubeScaleFactor (originCube 2 n)) b L.1 *
        Real.sqrt (∑ l ∈ s,
          lemmaVTiledWeakEnergy (originCube 2 n) 0 (z l).toH1Function.grad) *
        Real.sqrt (lemmaVTiledWeakEnergy (originCube 2 n) 0 g.grad) := by
  let Q := originCube 2 n
  let U := openCubeSet Q
  let I := diagInterpolant Q 0
  let F := pureFluxMainQ3DistinctRow n b σ L s z
  let η (l : whiteBasisIndex) := pureFluxMainQ3BasisFrameMultiplier n b σ L l
  have hηraw (l : whiteBasisIndex) :
      MemLp (mainQ3DirectionW2 Q b L (whiteBasis l)).value.toFun
        (⊤ : ENNReal) (volume.restrict U) :=
    (mainQ3DirectionW2 Q b L (whiteBasis l)).value_memLp_top
  have hDηraw (l : whiteBasisIndex) (i : Fin 2) :
      MemLp (fun x => (mainQ3DirectionW2 Q b L (whiteBasis l)).value.grad x i)
        (⊤ : ENNReal) (volume.restrict U) :=
    (mainQ3DirectionW2 Q b L (whiteBasis l)).gradient_memLp_top_volume i
  have hη (l : whiteBasisIndex) :
      MemLp (η l).toFun (⊤ : ENNReal) (volume.restrict U) := by
    dsimp [η, pureFluxMainQ3BasisFrameMultiplier]
    simpa only [H1Function.smul_toFun, smul_eq_mul, mul_comm] using
      (hηraw l).const_mul (σ⁻¹)
  have hDη (l : whiteBasisIndex) (i : Fin 2) :
      MemLp (fun x => (η l).grad x i) (⊤ : ENNReal) (volume.restrict U) := by
    dsimp [η, pureFluxMainQ3BasisFrameMultiplier]
    simpa only [H1Function.smul_grad, Pi.smul_apply, smul_eq_mul] using
      (hDηraw l i).const_mul (σ⁻¹)
  have hFmem : MemVectorL2 U F := by
    change MemLp (fun x => ∑ l ∈ s,
      lemmaVPlanarRowField I (η l) (z l).toH1Function x) 2 (volumeMeasureOn U)
    exact memLp_finsetSum s fun l hl =>
      lemmaVPlanarRowField_memL2 I (η l) (z l).toH1Function (hη l) (hDη l)
  have hFcoord (i : Fin 2) :
      MemLp (fun x => F x i) 2 (normalizedCubeMeasure Q) :=
    memL2On_openCubeSet_normalizedCubeMeasure (hFmem.eval i)
  have hrow := pureFluxMainQ3_distinct_h10_row_bound n b σ L s z
  have hrowPos : ∀ R ∈ descendantsAtDepth Q 0, ∀ i : Fin 2,
      Summable (fun k => (Real.sqrt 3)^(k+1) *
        energy R (cubeIncrement R (k+1) (fun x => F x i))) := by
    intro R hR i
    have hRQ : R = Q := by
      simpa only [descendantsAtDepth_zero, Finset.mem_singleton] using hR
    subst R
    simpa [F] using hrow.1 i
  have hdual : |volumeAverage U (fun x => vecDot (F x) (g.grad x))| ≤
      Real.sqrt (lemmaVTiledWeakEnergy Q 0 g.grad) *
        Real.sqrt (lemmaVTiledPositiveEnergy Q 0 F) := by
    change |integralAverage U (fun x => vecDot (F x) (g.grad x))| ≤ _
    rw [← cubeAverage_eq_integralAverage_openCubeSet]
    have hcomm : (fun x => vecDot (F x) (g.grad x)) =
        fun x => vecDot (g.grad x) (F x) := by
      funext x
      exact vecDot_comm _ _
    rw [hcomm]
    exact lemmaV_tiled_pairing_le Q 0 g.grad_memL2_normalizedCubeMeasure
      hFcoord hrowPos
  have hrowBound : Real.sqrt (lemmaVTiledPositiveEnergy Q 0 F) ≤
      |σ⁻¹| * mainQ3RowConstant (cubeScaleFactor Q) b L.1 *
        Real.sqrt (∑ l ∈ s,
          lemmaVTiledWeakEnergy Q 0 (z l).toH1Function.grad) := by
    simpa [Q, F] using hrow.2
  calc
    _ = |volumeAverage U (fun x => vecDot (F x) (g.grad x))| := by rfl
    _ ≤ Real.sqrt (lemmaVTiledWeakEnergy Q 0 g.grad) *
        Real.sqrt (lemmaVTiledPositiveEnergy Q 0 F) := hdual
    _ ≤ Real.sqrt (lemmaVTiledWeakEnergy Q 0 g.grad) *
        (|σ⁻¹| * mainQ3RowConstant (cubeScaleFactor Q) b L.1 *
          Real.sqrt (∑ l ∈ s,
            lemmaVTiledWeakEnergy Q 0 (z l).toH1Function.grad)) :=
      mul_le_mul_of_nonneg_left hrowBound (Real.sqrt_nonneg _)
    _ = _ := by ring

/-- The weak-Haar energy of a scalar field is bounded by its L² energy. -/
theorem main_dualEnergy_le_energy (Q : TriadicCube 2) (f : Vec 2 → ℝ)
    (hf : MemLp f 2 (normalizedCubeMeasure Q)) :
    dualEnergy Q (Real.sqrt 3) f ≤ energy Q f := by
  have hq : 1 < Real.sqrt 3 := by
    nlinarith [Real.sqrt_nonneg (3 : ℝ),
      Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 3)]
  let r : ℝ := (Real.sqrt 3)⁻¹
  have hr0 : 0 ≤ r := by
    dsimp [r]
    positivity
  have hr1 : r < 1 := by
    dsimp [r]
    exact (inv_lt_one₀ (by positivity)).2 hq
  have hseries : Summable (fun k => r^k * energy Q (cubeProjection Q k f)) := by
    simpa [r] using summable_weighted_projections Q hq hf
  have hmajor : Summable (fun k => r^k * energy Q f) :=
    (summable_geometric_of_lt_one hr0 hr1).mul_right (energy Q f)
  have hsum := hseries.tsum_le_tsum (fun k =>
    mul_le_mul_of_nonneg_left (energy_projection_le Q k hf) (pow_nonneg hr0 k)) hmajor
  have hfactor : 0 ≤ 1 - r := sub_nonneg.mpr hr1.le
  rw [dualEnergy_eq Q hq hf]
  calc
    (1 - r) * ∑' k, r^k * energy Q (cubeProjection Q k f) ≤
        (1 - r) * ∑' k, r^k * energy Q f :=
      mul_le_mul_of_nonneg_left hsum hfactor
    _ = energy Q f := by
      rw [tsum_mul_right, tsum_geometric_of_lt_one hr0 hr1]
      field_simp [ne_of_gt (sub_pos.mpr hr1)]

/-- The vector weak-Haar energy is bounded by the coordinate L² energy. -/
theorem main_vectorWeakHaarEnergy_le_coordinateEnergy (Q : TriadicCube 2)
    (F : Vec 2 → Fin 2 → ℝ)
    (hF : ∀ i, MemLp (fun x => F x i) 2 (normalizedCubeMeasure Q)) :
    vectorWeakHaarEnergy Q F ≤ ∑ i, energy Q (fun x => F x i) := by
  unfold vectorWeakHaarEnergy
  apply Finset.sum_le_sum
  intro i hi
  exact main_dualEnergy_le_energy Q (fun x => F x i) (hF i)

/-- The depth-averaged weak Haar energy of a vector field is bounded by its
parent-cell coordinate L² energy. The bound is uniform over the DIAG mesh
depth because the cell averages partition the parent cube. -/
theorem main_tiledWeakHaarEnergy_le_coordinateEnergy (Q : TriadicCube 2) (m : ℕ)
    (F : Vec 2 → Fin 2 → ℝ)
    (hF : ∀ i, MemLp (fun x => F x i) 2 (normalizedCubeMeasure Q)) :
    lemmaVTiledWeakEnergy Q m F ≤ ∑ i, energy Q (fun x => F x i) := by
  have hpoint (R : TriadicCube 2) (hR : R ∈ descendantsAtDepth Q m) :
      vectorWeakHaarEnergy R F ≤ ∑ i, energy R (fun x => F x i) := by
    apply main_vectorWeakHaarEnergy_le_coordinateEnergy R F
    intro i
    exact memLp_on_descendant_of_memLp hR (hF i)
  have hsum : descendantsAverage Q m (fun R => ∑ i : Fin 2,
      energy R (fun x => F x i)) = ∑ i : Fin 2, energy Q (fun x => F x i) := by
    rw [descendantsAverage_sum]
    apply Finset.sum_congr rfl
    intro i hi
    exact (energy_eq_descendantsAverage Q m (hF i)).symm
  unfold lemmaVTiledWeakEnergy
  exact (descendantsAverage_le hpoint).trans_eq hsum

/-- Coordinate L² energy is the cube average of the Euclidean squared norm. -/
theorem main_coordinateEnergy_eq_cubeAverage_vecNormSq (Q : TriadicCube 2)
    (F : Vec 2 → Fin 2 → ℝ)
    (hF : ∀ i, MemLp (fun x => F x i) 2 (normalizedCubeMeasure Q)) :
    (∑ i : Fin 2, energy Q (fun x => F x i)) =
      cubeAverage Q (fun x => vecNormSq (F x)) := by
  rw [cubeAverage_eq_integral_normalizedCubeMeasure]
  simp_rw [energy_eq_integral_sq]
  have hvec : (fun x => vecNormSq (F x)) =
      fun x => ∑ i : Fin 2, (F x i)^2 := by
    funext x
    simp [vecNormSq, vecDot, pow_two]
  rw [hvec]
  have hsumInt := integral_finsetSum Finset.univ (fun i _ => (hF i).integrable_sq)
  simpa only [Finset.sum_apply] using hsumInt.symm

/-- The weak-Haar energy of a response variation's first potential is
controlled by the actual response-frame Hilbert norm with the exact `σ/ν`
coefficient. -/
theorem main_response_variation_first_potential_weak_energy_bound
    (n : ℤ) (ν σ : ℝ) (hν : 0 < ν) (hσ : 0 < σ)
    (k : ResponseCoefficient (openCubeSet (originCube 2 n)))
    (Y : (responseFrameEnergyVariationSpace
      (measurableSet_openCubeSet (originCube 2 n))
      (volume_openCubeSet_originCube_toReal_pos (d := 2) n)
      ν σ hν hσ k).toSubmodule) :
    ∃ z : H10Function (openCubeSet (originCube 2 n)),
      (fun x => (hilbertBlockL2ToBlockL2
        ((Y : EnergyCarrier (responseFrameEnergyData
          (measurableSet_openCubeSet (originCube 2 n))
          (volume_openCubeSet_originCube_toReal_pos (d := 2) n)
          ν σ hν hσ k))).down x).1) =ᵐ[
          volumeMeasureOn (openCubeSet (originCube 2 n))]
        z.toH1Function.grad ∧
      vectorWeakHaarEnergy (originCube 2 n) z.toH1Function.grad ≤
        (σ / ν) * ‖(Y : EnergyCarrier (responseFrameEnergyData
          (measurableSet_openCubeSet (originCube 2 n))
          (volume_openCubeSet_originCube_toReal_pos (d := 2) n)
          ν σ hν hσ k))‖^2 ∧
      ∀ m : ℕ, lemmaVTiledWeakEnergy (originCube 2 n) m z.toH1Function.grad ≤
        (σ / ν) * ‖(Y : EnergyCarrier (responseFrameEnergyData
          (measurableSet_openCubeSet (originCube 2 n))
          (volume_openCubeSet_originCube_toReal_pos (d := 2) n)
          ν σ hν hσ k))‖^2 := by
  let Q := originCube 2 n
  let U := openCubeSet Q
  let hU := isOpenBoundedConvexDomain_openCubeSet Q
  let hv := volume_openCubeSet_originCube_toReal_pos (d := 2) n
  let D := responseFrameEnergyData (measurableSet_openCubeSet Q) hv ν σ hν hσ k
  let X : HilbertBlockL2 U := ((Y : EnergyCarrier D)).down
  obtain ⟨z, hfirst⟩ := main_response_variation_first_potential n ν σ hν hσ k Y
  have hproj : (fun x => (hilbertFirstProjection U X) x) =ᵐ[
      volumeMeasureOn U] fun x =>
        (PiLp.proj 2 (fun _ : Fin 2 => HilbertVec 2) 0 :
          HilbertBlockVec 2 →L[ℝ] HilbertVec 2) (X x) := by
    simpa only [hilbertFirstProjection] using
      ((PiLp.proj 2 (fun _ : Fin 2 => HilbertVec 2) 0 :
        HilbertBlockVec 2 →L[ℝ] HilbertVec 2).coeFn_compLpL X)
  have htransport := coeFn_hilbertBlockL2ToBlockL2 X
  have hfirstNorm : ∀ᵐ x ∂volumeMeasureOn U,
      ‖(hilbertFirstProjection U X) x‖^2 = vecNormSq (z.toH1Function.grad x) := by
    filter_upwards [hproj, htransport, hfirst] with x hp ht hf
    rw [hp]
    have hf' : (X x).potential.toVec = z.toH1Function.grad x := by
      have h := hf
      rw [ht] at h
      simpa only [HilbertBlockVec.toBlockVec] using h
    calc
      ‖(PiLp.proj 2 (fun _ : Fin 2 => HilbertVec 2) 0) (X x)‖^2 =
          ‖(X x).potential‖^2 := by rfl
      _ = vecNormSq ((X x).potential.toVec) := (hilbertVec_vecNormSq _).symm
      _ = vecNormSq (z.toH1Function.grad x) := congrArg vecNormSq hf'
  have hfirstIntegral :
      ‖hilbertFirstProjection U X‖^2 =
        ∫ x, vecNormSq (z.toH1Function.grad x) ∂volumeMeasureOn U := by
    rw [hilbertL2_norm_sq_integral]
    exact integral_congr_ae hfirstNorm
  have hcube : cubeAverage Q (fun x => vecNormSq (z.toH1Function.grad x)) =
      (volume U).toReal⁻¹ * ‖hilbertFirstProjection U X‖^2 := by
    rw [cubeAverage_eq_integralAverage_openCubeSet]
    simp only [integralAverage, volumeMeasureOn]
    rw [hfirstIntegral]
  have hprojEnergy := hilbertFirstProjection_energy_bound
    (hU := hU.isOpen.measurableSet) (hvol := hv) ν σ hν hσ k X
  have hprojEnergy' : (ν / σ) * ‖hilbertFirstProjection U X‖^2 ≤
      (volume U).toReal * ‖(Y : EnergyCarrier D)‖^2 := by
    have hnormEq : D.energy X X = ‖(Y : EnergyCarrier D)‖^2 := by
      simpa [X] using (energyCarrier_norm_sq D (Y : EnergyCarrier D)).symm
    have hprojEnergy0 : (ν / σ) * ‖hilbertFirstProjection U X‖^2 ≤
        cubeVolume Q * D.energy X X := by
      simpa [D, X] using hprojEnergy
    calc
      _ ≤ cubeVolume Q * D.energy X X := hprojEnergy0
      _ = (volume U).toReal * ‖(Y : EnergyCarrier D)‖^2 := by
        rw [volume_openCubeSet_toReal, hnormEq]
  have hgradAverage : cubeAverage Q (fun x => vecNormSq (z.toH1Function.grad x)) ≤
      (σ / ν) * ‖(Y : EnergyCarrier D)‖^2 := by
    rw [hcube]
    have hvolInv : 0 ≤ (volume U).toReal⁻¹ := by positivity
    have hscaled : (ν / σ) *
        ((volume U).toReal⁻¹ * ‖hilbertFirstProjection U X‖^2) ≤
        ‖(Y : EnergyCarrier D)‖^2 := by
      calc
        _ = (volume U).toReal⁻¹ *
            ((ν / σ) * ‖hilbertFirstProjection U X‖^2) := by ring
        _ ≤ (volume U).toReal⁻¹ *
            ((volume U).toReal * ‖(Y : EnergyCarrier D)‖^2) :=
          mul_le_mul_of_nonneg_left hprojEnergy' hvolInv
        _ = _ := by
          have hvol : 0 < (volume U).toReal := hv
          field_simp [hvol.ne']
    have hrecip : (σ / ν) * (ν / σ) = 1 := by
      field_simp [hν.ne', hσ.ne']
    calc
      _ = ((σ / ν) * (ν / σ)) *
          ((volume U).toReal⁻¹ * ‖hilbertFirstProjection U X‖^2) := by
            rw [hrecip, one_mul]
      _ = (σ / ν) * ((ν / σ) *
          ((volume U).toReal⁻¹ * ‖hilbertFirstProjection U X‖^2)) := by ring
      _ ≤ (σ / ν) * ‖(Y : EnergyCarrier D)‖^2 :=
        mul_le_mul_of_nonneg_left hscaled (div_nonneg hσ.le hν.le)
  have hweak := main_vectorWeakHaarEnergy_le_coordinateEnergy Q
    z.toH1Function.grad (fun i => z.toH1Function.grad_memL2_normalizedCubeMeasure i)
  have hcoordinateEnergy := main_coordinateEnergy_eq_cubeAverage_vecNormSq Q
    z.toH1Function.grad
    (fun i => z.toH1Function.grad_memL2_normalizedCubeMeasure i)
  refine ⟨z, hfirst, ?_, ?_⟩
  · exact hweak.trans (hcoordinateEnergy ▸ hgradAverage)
  · intro m
    exact (main_tiledWeakHaarEnergy_le_coordinateEnergy Q m
      z.toH1Function.grad
      (fun i => z.toH1Function.grad_memL2_normalizedCubeMeasure i)).trans
      (hcoordinateEnergy ▸ hgradAverage)

/-- A finite family of actual response variations has the same q3 row bound
after converting each variation to its source first-potential representative.
The theorem also retains the exact response-energy control of every chosen
representative. -/
theorem main_q3_variation_family_shear_pairing_bound
    (n : ℤ) (ν σ b : ℝ) (hν : 0 < ν) (hσ : 0 < σ)
    (L : {l : ℝ // 0 < l}) (s : Finset whiteBasisIndex)
    (k : ResponseCoefficient (openCubeSet (originCube 2 n))) (P : BlockVec 2)
    (u : AHarmonicFunction (responseFramePlanarCoefficientField ν σ k)
      (openCubeSet (originCube 2 n)))
    (w : AHarmonicFunction
      (adjointCoeffField (responseFramePlanarCoefficientField ν σ k))
      (openCubeSet (originCube 2 n)))
    (hrep : hilbertBlockL2ToBlockL2
        ((responseFrameMuOperatorSystemData
          (isOpenBoundedConvexDomain_openCubeSet (originCube 2 n)).isOpen.measurableSet
          (volume_openCubeSet_originCube_toReal_pos (d := 2) n)
          ν σ hν hσ k).toMuHilbertRealization.minimizerMap P) =ᵐ[
          volumeMeasureOn (openCubeSet (originCube 2 n))]
        (fun x => (blockResponsePairHalfState
          (responseFramePlanarCoefficientField ν σ k) u w).eval x))
    (Y : whiteBasisIndex →
      (responseFrameEnergyVariationSpace
        (measurableSet_openCubeSet (originCube 2 n))
        (volume_openCubeSet_originCube_toReal_pos (d := 2) n)
        ν σ hν hσ k).toSubmodule) :
    ∃ z : whiteBasisIndex → H10Function (openCubeSet (originCube 2 n)),
      (∀ l, (fun x => (hilbertBlockL2ToBlockL2
          ((Y l : EnergyCarrier (responseFrameEnergyData
            (measurableSet_openCubeSet (originCube 2 n))
            (volume_openCubeSet_originCube_toReal_pos (d := 2) n)
            ν σ hν hσ k))).down x).1) =ᵐ[
            volumeMeasureOn (openCubeSet (originCube 2 n))]
          (z l).toH1Function.grad) ∧
      (∀ l, vectorWeakHaarEnergy (originCube 2 n) (z l).toH1Function.grad ≤
          (σ / ν) * ‖(Y l : EnergyCarrier (responseFrameEnergyData
            (measurableSet_openCubeSet (originCube 2 n))
            (volume_openCubeSet_originCube_toReal_pos (d := 2) n)
            ν σ hν hσ k))‖^2) ∧
      |∑ l ∈ s, inner ℝ
          (responseFrameEnergyBaseMinimizer
            (measurableSet_openCubeSet (originCube 2 n))
            (volume_openCubeSet_originCube_toReal_pos (d := 2) n)
            ν σ hν hσ k P)
          (responseFrameEnergyShearFamily
            (measurableSet_openCubeSet (originCube 2 n))
            (volume_openCubeSet_originCube_toReal_pos (d := 2) n)
            ν σ hν hσ k
            (pureFluxMainCubeQ3ResponseCoefficient n b L
              (@Encodable.encode whiteBasisIndex
                (Encodable.ofCountable whiteBasisIndex) l))
            (Y l : EnergyCarrier (responseFrameEnergyData
              (measurableSet_openCubeSet (originCube 2 n))
              (volume_openCubeSet_originCube_toReal_pos (d := 2) n)
              ν σ hν hσ k)))| ≤
        |σ⁻¹| * mainQ3RowConstant
          (cubeScaleFactor (originCube 2 n)) b L.1 *
          Real.sqrt (∑ l ∈ s,
            lemmaVTiledWeakEnergy (originCube 2 n) 0
              (z l).toH1Function.grad) *
          Real.sqrt (lemmaVTiledWeakEnergy (originCube 2 n) 0
            ((1 / 2 : ℝ) • (w.toH1 - u.toH1)).grad) := by
  let Q := originCube 2 n
  let U := openCubeSet Q
  let hU := isOpenBoundedConvexDomain_openCubeSet Q
  let hv := volume_openCubeSet_originCube_toReal_pos (d := 2) n
  let D := responseFrameEnergyData (measurableSet_openCubeSet Q) hv ν σ hν hσ k
  let V := responseFrameEnergyVariationSpace (measurableSet_openCubeSet Q) hv ν σ hν hσ k
  let S := responseFrameEnergyBaseMinimizer (measurableSet_openCubeSet Q) hv ν σ hν hσ k P
  let C := responseFrameEnergyShearFamily (measurableSet_openCubeSet Q) hv ν σ hν hσ k
  let g : H1Function U := (1 / 2 : ℝ) • (w.toH1 - u.toH1)
  let H (l : whiteBasisIndex) := pureFluxMainCubeQ3ResponseCoefficient n b L
    (@Encodable.encode whiteBasisIndex (Encodable.ofCountable whiteBasisIndex) l)
  let η (l : whiteBasisIndex) := pureFluxMainQ3BasisFrameMultiplier n b σ L l
  let z (l : whiteBasisIndex) := Classical.choose
    (main_response_variation_first_potential_weak_energy_bound
      n ν σ hν hσ k (Y l))
  have hz (l : whiteBasisIndex) := (Classical.choose_spec
    (main_response_variation_first_potential_weak_energy_bound
      n ν σ hν hσ k (Y l))).1
  have hzEnergy (l : whiteBasisIndex) := (Classical.choose_spec
    (main_response_variation_first_potential_weak_energy_bound
      n ν σ hν hσ k (Y l))).2.1
  have hzTiledEnergy (l : whiteBasisIndex) (m : ℕ) := (Classical.choose_spec
    (main_response_variation_first_potential_weak_energy_bound
      n ν σ hν hσ k (Y l))).2.2 m
  have hrowDir (l : whiteBasisIndex) (hl : l ∈ s) :
      inner ℝ S (C (H l) (Y l : EnergyCarrier D)) =
        volumeAverage U (fun x => vecDot
          (lemmaVPlanarRowField (diagInterpolant Q 0) (η l)
            (z l).toH1Function x) (g.grad x)) := by
    have hp := main_q3_response_shear_pairing_eq_diag_row_of_first_potential
      n ν σ b hν hσ L l k P u w hrep (Y l : EnergyCarrier D) (z l) (hz l)
    simpa [Q, U, D, S, C, H, η, g] using hp
  have hsumPair : (∑ l ∈ s, inner ℝ S (C (H l) (Y l : EnergyCarrier D))) =
      volumeAverage U (fun x => vecDot
        (pureFluxMainQ3DistinctRow n b σ L s z x) (g.grad x)) := by
    calc
      _ = ∑ l ∈ s, volumeAverage U (fun x => vecDot
          (lemmaVPlanarRowField (diagInterpolant Q 0) (η l)
            (z l).toH1Function x) (g.grad x)) := by
        apply Finset.sum_congr rfl
        intro l hl
        exact hrowDir l hl
      _ = volumeAverage U (fun x => ∑ l ∈ s, vecDot
          (lemmaVPlanarRowField (diagInterpolant Q 0) (η l)
            (z l).toH1Function x) (g.grad x)) := by
        rw [volumeAverage_sum]
        intro l hl
        exact integrableOn_vecDot_of_memVectorL2
          (lemmaVPlanarRowField_memL2 (diagInterpolant Q 0) (η l)
            (z l).toH1Function (by
              dsimp [η, pureFluxMainQ3BasisFrameMultiplier]
              simpa only [H1Function.smul_toFun, smul_eq_mul, mul_comm] using
                (mainQ3DirectionW2 Q b L (whiteBasis l)).value_memLp_top.const_mul
                  (σ⁻¹))
            (by
              intro i
              dsimp [η, pureFluxMainQ3BasisFrameMultiplier]
              have hcomponent :=
                (mainQ3DirectionW2 Q b L (whiteBasis l)).gradient_memLp_top_volume i
              simpa only [H1Function.smul_grad, Pi.smul_apply, smul_eq_mul] using
                hcomponent.const_mul (σ⁻¹))) g.grad_memVectorL2
      _ = _ := by
        congr 1
        funext x
        simp only [vecDot, pureFluxMainQ3DistinctRow]
        rw [Finset.sum_comm]
        simp only [Finset.sum_apply]
        apply Finset.sum_congr rfl
        intro i hi
        rw [Finset.sum_mul]
  have hzall : ∀ l, (fun x => (hilbertBlockL2ToBlockL2
        ((Y l : EnergyCarrier D)).down x).1) =ᵐ[volumeMeasureOn U]
        (z l).toH1Function.grad := by
    intro l
    simpa [Q, D] using hz l
  refine ⟨z, hzall, ?_, ?_⟩
  · intro l
    simpa [Q, z] using hzEnergy l
  · rw [hsumPair]
    simpa [Q, U, g] using main_q3_distinct_h10_row_pairing_bound n b σ L s z g


end ASDExplicitGamma.Main
