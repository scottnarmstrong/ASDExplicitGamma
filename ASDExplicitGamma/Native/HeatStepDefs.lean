/-- `Q_N`: the outward 20th root of the 20th Gaussian clock moment. -/
def nativeHeatQNGen (ns : ℕ) : ℚ := nativeRootUp ((nativeHeatGenQm ns).getD 20 0) 20

/-- The direct (time-one) individual child cap `y₀ = shifted_frame(1, min(old.x, individual))`. -/
def nativeHeatY0Gen (ns : ℕ) : ℚ :=
  nativeShiftedFrame 1 (min (nativeHeatOldRowGen ns).x (nativeHeatIndividualGen ns).1)

/-- The configured heat frames `(X, Y₀, F)` for `ns` shells. -/
def nativeHeatFramesGen (ns : ℕ) : NativeHeatFrameInputs :=
  nativeHeatFrames nativeHeatParametersData (nativeHeatOldRowGen ns)
    (nativeHeatIndividualGen ns).1 (nativeHeatGenVariance ns) (nativeHeatQNGen ns)

def nativeHeatExpArgGen (ns : ℕ) : ℚ := nativeHeatExpArg (nativeHeatOldRowGen ns)

def nativeHeatExpGen (ns : ℕ) : ℚ := nativeHeatExpUpper (nativeHeatExpArgGen ns)

def nativeHeatCoefGen (ns : ℕ) : List ℚ := nativeHeatCoefficients (nativeHeatExpGen ns)

/-- The initial heat moment rows `init(h)`. -/
def nativeHeatInitGen (ns : ℕ) : List ℚ :=
  nativeHeatInitial nativeHeatParametersData (nativeHeatGenQm ns) (nativeHeatGenVariance ns)

def nativeHeatBaseGen (ns : ℕ) : ℚ :=
  nativeHeatBase (nativeHeatCoefGen ns) (nativeHeatInitGen ns)

/-- The fixed forcing rows. -/
def nativeHeatFixedGen (ns : ℕ) : List ℚ :=
  (List.range 20).map fun j =>
    nativeHeatFixedAt (nativeHeatOldRowGen ns) (nativeHeatFramesGen ns) (j + 1)

/-- The 48-pass cap. -/
def nativeHeatY48Gen (ns : ℕ) : ℚ :=
  nativeHeatPasses (nativeHeatOldRowGen ns) (nativeHeatFramesGen ns)
    (nativeHeatCoefGen ns) (nativeHeatFixedGen ns) (nativeHeatBaseGen ns) 48
    (nativeHeatFramesGen ns).y

/-- The first-moment (mean) return. -/
def nativeHeatMeanGen (ns : ℕ) : ℚ :=
  nativeUp (nativeHeatExpGen ns * (nativeHeatInitGen ns).getD 1 0 +
    4 * (nativeHeatExpGen ns - 1) +
    nativeHeatExpGen ns * (nativeHeatFixedGen ns).getD 0 0)

/-- The heat return `(min Y₄₈ y₀, mean)` for `ns` shells. -/
def nativeHeatResultGen (ns : ℕ) : ℚ × ℚ :=
  (min (nativeHeatY48Gen ns) (nativeHeatY0Gen ns), nativeHeatMeanGen ns)

