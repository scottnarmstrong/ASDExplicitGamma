module

public import ASDExplicitGamma.Numerics.Native.Certificate

/-! Exact completed source row caps (scope: same completed-law finite source
prefix replacement; all old tails and rare terms remain). The numerical
producer is sharper; these retain the exact downstream certificate interface.
The six-digit displays are only weaker corollaries. -/
@[expose] public section
namespace ASDExplicitGamma.Native
open ASDExplicitGamma.Numerics.Native

/-- The six exact rational completed mean caps, including the main panel a5. -/
def nativeSourceExactMeanCaps : List ℚ := [
  3/50,
  6802370268936328807052173164189/100000000000000000000000000000000,
  369044574816859975069814509923/5000000000000000000000000000000,
  7896482306527751195279551457217/100000000000000000000000000000000,
  8392611373095084661337932723209/100000000000000000000000000000000,
  4441091003104432097305984305313/50000000000000000000000000000000]

/-- The six exact rational complete weak-row charges of the source certificate. -/
def nativeSourceExactWeakCaps : List ℚ := [
  ,
  ,
  ,
  ,
  ,
  ]

/-- The corrected numerical producer implies every retained exact source cap. -/
theorem native_source_exact_caps_of_certificate (r : Fin 6) :
    nativeCompletedMeanRows.getD r.val 0≤nativeSourceExactMeanCaps.getD r.val 0 ∧
    nativeCompletedWeakRows.getD r.val 0≤nativeSourceExactWeakCaps.getD r.val 0 := by
  revert r
  decide +kernel

/-- The displayed six-digit values are weaker exact rational upper bounds. -/
theorem native_source_exact_caps_le_rounded (r : Fin 6) :
    nativeSourceExactMeanCaps.getD r.val 0≤nativeCompletedMeanCaps.getD r.val 0 ∧
    nativeSourceExactWeakCaps.getD r.val 0≤nativeCompletedWeakCaps.getD r.val 0 := by
  revert r
  decide +kernel

end ASDExplicitGamma.Native
