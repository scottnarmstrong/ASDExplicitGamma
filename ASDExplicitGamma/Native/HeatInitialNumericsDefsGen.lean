/-- The configured center variance for `ns` shells. -/
def nativeHeatGenVariance (ns : ℕ) : ℚ :=
  (nativeHeatVariance ns (nativeHeatOldRowGen ns)).1

/-- The configured spectral clock for `ns` shells. -/
def nativeHeatGenSpectral (ns : ℕ) : ℚ :=
  (nativeHeatVariance ns (nativeHeatOldRowGen ns)).2

/-- The configured Gaussian moment list for `ns` shells. -/
def nativeHeatGenQm (ns : ℕ) : List ℚ :=
  nativeGaussianMoments (nativeHeatGenVariance ns) (nativeHeatGenSpectral ns)

theorem nativeHeatGenVariance_eq (ns : ℕ) :
    nativeHeatGenVariance ns =
      nativeUp ((1 + nativeHeatTheta) * (nativeHeatOldRowGen ns).e * (ns : ℚ)) := by
  unfold nativeHeatGenVariance nativeHeatVariance
  rfl

theorem nativeHeatGenSpectral_eq (ns : ℕ) :
    nativeHeatGenSpectral ns =
      nativeUp ((1 + nativeHeatTheta) * (nativeHeatOldRowGen ns).e *
        min (ns : ℚ) (((max (ns - 8) 0 : ℕ) : ℚ) + 25 / 72)) := by
  unfold nativeHeatGenSpectral nativeHeatVariance
  rfl

theorem nativeHeatGenQm_eq (ns : ℕ) :
    nativeHeatGenQm ns =
      nativeGaussianMoments (nativeHeatGenVariance ns) (nativeHeatGenSpectral ns) := by
  unfold nativeHeatGenQm
  rfl

theorem nativeGaussianMoments_getD_zero (v s : ℚ) :
    (nativeGaussianMoments v s).getD 0 0 = 1 := by
  have key : ∀ n : ℕ, ∃ t : List ℚ,
      (List.range n).foldl (fun qm j => nativeGaussianMomentStep v s qm (j + 1)) [1] =
        1 :: t := by
    intro n
    induction n with
    | zero => exact ⟨[], rfl⟩
    | succ n ih =>
        obtain ⟨t, ht⟩ := ih
        rw [List.range_succ, List.foldl_append, ht]
        exact ⟨t ++ [nativeUp (((1 :: t).getLast!) * (v + 2 * ((n + 1 - 1 : ℕ) : ℚ) * s))], rfl⟩
  obtain ⟨t, ht⟩ := key 20
  unfold nativeGaussianMoments
  rw [ht]
  rfl

theorem nativeHeatGenQm_getD_zero (ns : ℕ) : (nativeHeatGenQm ns).getD 0 0 = 1 := by
  rw [nativeHeatGenQm_eq]
  exact nativeGaussianMoments_getD_zero _ _

theorem nativeUp_idem (q : ℚ) : nativeUp (nativeUp q) = nativeUp q := by
  have hs : (nativeScale : ℚ) ≠ 0 := ne_of_gt (by decide +kernel)
  unfold nativeUp
  rw [div_mul_cancel₀ _ hs, Int.ceil_intCast]

theorem nativeGaussianMoments_getD_one (v s : ℚ) :
    (nativeGaussianMoments v s).getD 1 0 = nativeUp v := by
  have key : ∀ n : ℕ, ∃ t : List ℚ,
      (List.range (n + 1)).foldl
        (fun qm j => nativeGaussianMomentStep v s qm (j + 1)) [1] =
        1 :: nativeUp v :: t := by
    intro n
    induction n with
    | zero => exact ⟨[], by simp [nativeGaussianMomentStep]⟩
    | succ n ih =>
        obtain ⟨t, ht⟩ := ih
        rw [List.range_succ, List.foldl_append, ht]
        exact ⟨t ++ [nativeUp (((1 :: nativeUp v :: t).getLast!) *
          (v + 2 * ((n + 1 + 1 - 1 : ℕ) : ℚ) * s))], rfl⟩
  obtain ⟨t, ht⟩ := key 19
  unfold nativeGaussianMoments
  rw [ht]
  rfl

theorem nativeHeatGenQm_getD_one (ns : ℕ) :
    (nativeHeatGenQm ns).getD 1 0 = nativeHeatGenVariance ns := by
  rw [nativeHeatGenQm_eq, nativeGaussianMoments_getD_one, nativeHeatGenVariance_eq,
    nativeUp_idem]

attribute [irreducible] nativeHeatOldRowGen nativeHeatGenVariance
  nativeHeatGenSpectral nativeHeatGenQm

end ASDExplicitGamma.Native
