/-- Named grid endpoint for the cold-lag-40 mean `E T(Q_N; a_(N-40))`. The cold estimate must
prove that its actual lag-40 mean is at most this value before applying the recurrence; this
panel certificate supplies the endpoint, not that cold estimate. -/
def mainReturnCold40Upper : ℕ := Spike.cold40Upper

/-- Exact grid-unit endpoint returned by composing the 40 × 8 leaf recurrences from
`mainReturnCold40Upper`. -/
def mainReturnUpperUnits : ℕ := 5921159502433712501805269299593

def mainReturnComposedUnits : ℕ := mainCert.foldl Spike.advanceInsertion mainReturnCold40Upper

theorem mainReturnComposedUnits_eq_composeUpper :
    mainReturnComposedUnits = Spike.composeUpper mainCert := rfl

def mainReturnCompositionCheck : Bool := decide
  (Spike.composeUpper mainCert = mainReturnUpperUnits ∧
    mainReturnUpperUnits * 50 < 3 * Spike.gridScale)

theorem mainReturnComposition_kernel_check : mainReturnCompositionCheck = true := by
  decide +kernel

theorem mainReturn_composeUpper_eq :
    Spike.composeUpper mainCert = 5921159502433712501805269299593 := by
  have h := of_decide_eq_true mainReturnComposition_kernel_check
  simpa [mainReturnCompositionCheck, mainReturnUpperUnits] using h.1

/-- The real-valued trajectory produced by exactly the leaf-derived records in `mainCert`. -/
noncomputable def mainReturnTrajectory : ℝ :=
  (mainReturnComposedUnits : ℝ) / (Spike.gridScale : ℝ)

theorem mainReturnTrajectory_eq_composedUpper :
    mainReturnTrajectory =
      (Spike.composeUpper mainCert : ℝ) / (Spike.gridScale : ℝ) := by
  rw [mainReturnTrajectory, ← mainReturnComposedUnits_eq_composeUpper]

/-- The exact rational endpoint supplied by the leaf-derived 40-insertion composition. -/
def mainReturnRationalBound : ℚ :=
  (mainReturnUpperUnits : ℚ) / (Spike.gridScale : ℚ)

theorem mainReturnTrajectory_eq_rational :
    mainReturnTrajectory = (mainReturnRationalBound : ℝ) := by
  have hUnits : mainReturnComposedUnits = mainReturnUpperUnits := by
    rw [mainReturnComposedUnits_eq_composeUpper]
    exact mainReturn_composeUpper_eq
  unfold mainReturnTrajectory mainReturnRationalBound
  rw [hUnits]
  rw [Rat.cast_div, Rat.cast_natCast, Rat.cast_natCast]

theorem mainReturnRationalBound_lt_three_fiftieth :
    (mainReturnRationalBound : ℝ) < (3 / 50 : ℝ) := by
  rw [← mainReturnTrajectory_eq_rational]
  unfold mainReturnTrajectory
  have hUnits : mainReturnComposedUnits = mainReturnUpperUnits := by
    rw [mainReturnComposedUnits_eq_composeUpper]
    exact mainReturn_composeUpper_eq
  rw [hUnits]
  have hparts := of_decide_eq_true mainReturnComposition_kernel_check
  have hlt : mainReturnUpperUnits * 50 < 3 * Spike.gridScale := hparts.2
  rw [div_lt_div_iff₀ (by norm_num [Spike.gridScale]) (by norm_num : (0 : ℝ) < 50)]
  exact_mod_cast hlt

theorem mainReturn_composed_lt_three_fiftieth :
    (Spike.composeUpper mainCert : ℝ) / (Spike.gridScale : ℝ) < (3 / 50 : ℝ) := by
  rw [← mainReturnTrajectory_eq_composedUpper]
  exact lt_of_le_of_lt mainReturnTrajectory_eq_rational.le
    mainReturnRationalBound_lt_three_fiftieth

