theorem mainReturn_certificate' :
    mainReturnAllPanelBounds ∧
      mainReturnAllRecurrenceFieldBounds ∧
      mainReturnTrajectory =
        (Spike.composeUpper mainCert : ℝ) / (Spike.gridScale : ℝ) ∧
      mainReturnTrajectory ≤ (mainReturnRationalBound : ℝ) ∧
      (mainReturnRationalBound : ℝ) < (3 / 50 : ℝ) ∧
      (Spike.composeUpper mainCert : ℝ) / (Spike.gridScale : ℝ) < (3 / 50 : ℝ) := by
  exact ⟨mainReturn_all_panel_formula_bounds,
    ⟨mainReturn_all_recurrence_field_bounds,
      ⟨mainReturnTrajectory_eq_composedUpper,
      ⟨mainReturnTrajectory_eq_rational.le,
        ⟨mainReturnRationalBound_lt_three_fiftieth,
          mainReturn_composed_lt_three_fiftieth⟩⟩⟩⟩⟩

