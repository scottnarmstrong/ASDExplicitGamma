/-- Convert a complete formula leaf record into the panel data consumed by the affine recurrence.
Every recurrence field comes from this same leaf endpoint structure. -/
def PanelEndpoints.toPanelCert (e : PanelEndpoints) : PanelCert :=
  { aUpper := e.aUpper, ellLower := e.ellLower,
    rhoLower := e.rhoLower, rhoUpper := e.rhoUpper,
    offsetLower := e.offsetLower, offsetUpper := e.offsetUpper,
    supportELower := e.supportELower, supportEUpper := e.supportEUpper,
    supportLambdaLower := e.supportLambdaLower, supportLambdaUpper := e.supportLambdaUpper,
    supportJLower := e.supportJLower, supportJUpper := e.supportJUpper }

/-- The insertion frame and its panel formula leaves, all generated by the absolute-branch
formula run. -/
def MainInsertionEndpoints.toInsertionCert (e : MainInsertionEndpoints) : InsertionCert :=
  { observer := e.observer, frameLower := e.frameLower, frameUpper := e.frameUpper,
    panels := e.panels.map PanelEndpoints.toPanelCert }

