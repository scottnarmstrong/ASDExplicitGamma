    (∀ i : Fin 21, 0 ≤ nativeGap016System.v.getD i.val 0 ∧ nativeGap016System.v.getD i.val 0 ≤ 1) ∧
    (∀ i : Fin 21, 0 ≤ nativeGap016System.subdiag.getD i.val 0 ∧ nativeGap016System.subdiag.getD i.val 0 ≤ 1/2) ∧
