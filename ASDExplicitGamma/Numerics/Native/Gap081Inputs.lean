    (∀ i : Fin 21, 0 ≤ nativeGap081System.v.getD i.val 0 ∧ nativeGap081System.v.getD i.val 0 ≤ 1) ∧
    (∀ i : Fin 21, 0 ≤ nativeGap081System.subdiag.getD i.val 0 ∧ nativeGap081System.subdiag.getD i.val 0 ≤ 1/2) ∧
