    (∀ i : Fin 21, 0 ≤ nativeGap131System.v.getD i.val 0 ∧ nativeGap131System.v.getD i.val 0 ≤ 1) ∧
    (∀ i : Fin 21, 0 ≤ nativeGap131System.subdiag.getD i.val 0 ∧ nativeGap131System.subdiag.getD i.val 0 ≤ 1/2) ∧
    (∀ i : Fin 21, 0 ≤ nativeGap131System.diag.getD i.val 0 ∧ 0 ≤ nativeGap131System.force.getD i.val 0 ∧ nativeGap131System.force.getD i.val 0 ≤ (1/2 : ℚ)^i.val) ∧
    (∀ i : Fin 21, nativeGap131System.subdiag.getD i.val 0+nativeGap131System.diag.getD i.val 0+nativeGap131System.force.getD i.val 0 ≤ 6) := by
  decide +kernel

end ASDExplicitGamma.Numerics.Native
