/-! The complete native numerical certificate family.
All endpoint inputs are closed data: the boundary-fixed OLD q1 and parents, the six
completed prefixes at Q*, all 153 systems, all 48-pass returns, every finite history depth,
and both complete raw tails. The scalar parameter lemmas expose their source domains.
-/
@[expose] public section
namespace ASDExplicitGamma.Numerics.Native

def nativeCompletedMeanRows : List ℚ :=
  [nativeSource0Result.1,nativeSource1Result.1,nativeSource2Result.1,
    nativeSource3Result.1,nativeSource4Result.1,nativeSource5Result.1]

def nativeCompletedWeakRows : List ℚ :=
  [nativeSource0Result.2,nativeSource1Result.2,nativeSource2Result.2,
    nativeSource3Result.2,nativeSource4Result.2,nativeSource5Result.2]

def nativeCompletedMeanCaps : List ℚ := [3/50,68024/10^6,73809/10^6,78965/10^6,83927/10^6,88822/10^6]
def nativeCompletedWeakCaps : List ℚ := [101634/10^6,111185/10^6,119070/10^6,126483/10^6,133757/10^6,141001/10^6]

/-- Every completed source row, retaining the carried Q* and all old rare and tail terms. -/
theorem native_completed_source_caps (r : Fin 6) :
    nativeCompletedMeanRows.getD r.val 0 ≤ nativeCompletedMeanCaps.getD r.val 0 ∧
    nativeCompletedWeakRows.getD r.val 0 < nativeCompletedWeakCaps.getD r.val 0 := by
  revert r
  decide +kernel

end ASDExplicitGamma.Numerics.Native
