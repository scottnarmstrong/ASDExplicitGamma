    (∀ i : Fin 21, 0 ≤ nativeGap050System.diag.getD i.val 0 ∧ 0 ≤ nativeGap050System.force.getD i.val 0 ∧ nativeGap050System.force.getD i.val 0 ≤ (1/2 : ℚ)^i.val) ∧
    (∀ i : Fin 21, nativeGap050System.subdiag.getD i.val 0+nativeGap050System.diag.getD i.val 0+nativeGap050System.force.getD i.val 0 ≤ 6) := by
  decide +kernel

