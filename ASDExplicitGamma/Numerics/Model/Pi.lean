def piRootStepCheck (n : ℕ) : Bool := decide
  (0 ≤ piRootlo n ∧ 0 ≤ piRoothi (n+1) ∧
    (piRootlo (n+1))^2 ≤ 2+piRootlo n ∧ 2+piRoothi n ≤ (piRoothi (n+1))^2)

theorem pi_root_steps_0 : (List.range 8).all (fun n => piRootStepCheck (8*0+n)) = true := by
  decide +kernel

