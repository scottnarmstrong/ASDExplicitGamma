module

public import Mathlib.Analysis.Calculus.Deriv.Mul
public import Mathlib.Analysis.InnerProductSpace.Projection.Basic
public import Mathlib.Topology.Algebra.Module.ContinuousLinearMap.Basic

@[expose] public section

namespace ASDExplicitGamma.Model

/-!  First-chaos reduction for an invariant closed span of Koopman translates.

This file isolates the Hilbert-space step from the q3 spectral calculation.  It
uses only invariance of a closed span under a unitary group action; no Gaussian
chaos decomposition is involved.
-/

variable {G H : Type*} [AddCommGroup G]
  [NormedAddCommGroup H] [InnerProductSpace ℝ H]

/-- The closed cyclic subspace generated by the translates of one observable. -/
def KoopmanOrbitSubspace (τ : G → H →ₗᵢ[ℝ] H) (v : H) : Submodule ℝ H :=
  (Submodule.span ℝ (Set.range fun z : G => τ z v)).topologicalClosure

/-- A closed orbit span in a Hilbert space has its orthogonal projection. -/
instance koopmanOrbitSubspace_hasOrthogonalProjection
    [CompleteSpace H] (τ : G → H →ₗᵢ[ℝ] H) (v : H) :
    (KoopmanOrbitSubspace τ v).HasOrthogonalProjection := by
  have hcomplete : CompleteSpace (KoopmanOrbitSubspace τ v) := by
    change CompleteSpace
      (Submodule.span ℝ (Set.range fun z : G => τ z v)).topologicalClosure
    infer_instance
  infer_instance

/-- The group law sends every generator of the cyclic subspace to another
generator. -/
theorem koopmanOrbitSubspace_stable
    (τ : G → H →ₗᵢ[ℝ] H) (v : H)
    (hτ : ∀ z w x, τ (z + w) x = τ z (τ w x)) (z : G) :
    ∀ x ∈ KoopmanOrbitSubspace τ v, τ z x ∈ KoopmanOrbitSubspace τ v := by
  let S : Submodule ℝ H := Submodule.span ℝ (Set.range fun w : G => τ w v)
  have hS : S ∈ Module.End.invtSubmodule
      (τ z).toContinuousLinearMap := by
    rw [Module.End.mem_invtSubmodule_iff_map_le]
    change S.map (τ z).toLinearMap ≤ S
    rw [Submodule.map_le_iff_le_comap]
    apply Submodule.span_le.2
    rintro x ⟨w, rfl⟩
    exact Submodule.subset_span ⟨z + w, hτ z w v⟩
  have hclosure := Submodule.topologicalClosure_mem_invtSubmodule
    (f := (τ z).toContinuousLinearMap) hS
  rw [Module.End.mem_invtSubmodule_iff_map_le] at hclosure
  intro x hx
  exact hclosure ⟨x, hx, rfl⟩

/-- The orthogonal projection onto a cyclic Koopman subspace commutes with
every translation.  The inverse translation preserves the same subspace, so
the orthogonal complement is invariant as well. -/
theorem koopmanOrbitProjection_commute
    [CompleteSpace H]
    (τ : G → H →ₗᵢ[ℝ] H) (v : H)
    (hτ : ∀ z w x, τ (z + w) x = τ z (τ w x))
    (hτinv : ∀ z x, τ z (τ (-z) x) = x)
    (z : G) (x : H) :
    (KoopmanOrbitSubspace τ v).starProjection (τ z x) =
      τ z ((KoopmanOrbitSubspace τ v).starProjection x) := by
  let K := KoopmanOrbitSubspace τ v
  have hmem : τ z (K.starProjection x) ∈ K :=
    koopmanOrbitSubspace_stable τ v hτ z _ (K.starProjection_apply_mem x)
  have horth : τ z x - τ z (K.starProjection x) ∈ Kᗮ := by
    have hsub : τ z (x - K.starProjection x) =
        τ z x - τ z (K.starProjection x) := (τ z).map_sub _ _
    rw [← hsub]
    rw [Submodule.mem_orthogonal']
    intro y hy
    have hy' : τ (-z) y ∈ K :=
      koopmanOrbitSubspace_stable τ v hτ (-z) y hy
    calc
      inner ℝ (τ z (x - K.starProjection x)) y =
          inner ℝ (τ z (x - K.starProjection x)) (τ z (τ (-z) y)) := by
            rw [hτinv z y]
      _ = inner ℝ (x - K.starProjection x) (τ (-z) y) :=
        (τ z).inner_map_map _ _
      _ = 0 := K.starProjection_inner_eq_zero x _ hy'
  exact Submodule.eq_starProjection_of_mem_orthogonal hmem horth

end ASDExplicitGamma.Model

end
